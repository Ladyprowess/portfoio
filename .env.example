# PostHog browser configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Outreach reply tracking (optional). An address on a subdomain whose MX points
# to Resend, e.g. track@reply.ladyprowess.com. Cold emails list it as a second
# Reply-To, so replies reach your inbox AND mark the lead as Replied.
OUTREACH_REPLY_TRACKING_ADDRESS=
